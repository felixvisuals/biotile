# --- Tripo -----------------------------------------------------------------
# mock: replays fixtures from tests/fixtures/tripo (no key, no credits)
# live: real API calls; put your key below (server side only, never commit .env)
TRIPO_MODE=mock
TRIPO_API_KEY=
# Record live round trips as new mock fixtures (tests/fixtures/tripo/recorded/)
TRIPO_RECORD=false
# Simulated duration of a mock Tripo task in seconds
MOCK_TASK_SECONDS=4

# --- Infrastructure (defaults: SQLite + local files + in-process jobs) ------
# DATABASE_URL=postgresql+psycopg://biotile:biotile@localhost:5432/biotile
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=biotile
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# QUEUE_BACKEND=rq
# REDIS_URL=redis://localhost:6379/0

# --- App ----------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5173
PIPELINE_INTERNAL_PX=2048
